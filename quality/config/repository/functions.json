{
    "version": 1,
    "python": {
        "max_trivial_statements": 2,
        "verbs": [
            "read",
            "save",
            "send",
            "parse",
            "build",
            "create",
            "choose",
            "list",
            "find",
            "plan",
            "rank",
            "validate",
            "describe",
            "format",
            "get",
            "set",
            "reset",
            "decode",
            "encode",
            "sanitize",
            "wait",
            "register",
            "delete",
            "download",
            "measure",
            "place"
        ],
        "predicates": ["is", "has"],
        "named_paths": ["src/", "scripts/", "__init__.py"],
        "allowlist": [
            {
                "path": "__init__.py",
                "names": ["comfy_entrypoint", "Extension.on_load", "Extension.get_node_list"],
                "reason": "ComfyUI calls these extension hooks itself."
            },
            {
                "path": "src/dreamina/generations/operation.py",
                "names": ["CollectOperation.validate", "GenerationOperation.validate"],
                "reason": "The run wrapper calls it through the Operation protocol."
            },
            {
                "path": "src/nodes/outputs.py",
                "names": ["build_result_document"],
                "reason": "Called by a node built in a later milestone."
            }
        ]
    },
    "shell": {
        "max_trivial_statements": 2
    }
}
