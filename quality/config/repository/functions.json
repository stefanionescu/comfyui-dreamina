{
    "version": 1,
    "python": {
        "max_trivial_statements": 2,
        "verbs": [
            "read",
            "save",
            "send",
            "parse",
            "build",
            "create",
            "choose",
            "list",
            "find",
            "plan",
            "rank",
            "validate",
            "describe",
            "format",
            "get",
            "set",
            "reset",
            "decode",
            "encode",
            "sanitize",
            "wait",
            "register",
            "delete",
            "download",
            "measure",
            "place"
        ],
        "predicates": ["is", "has"],
        "named_paths": ["src/", "scripts/", "__init__.py"],
        "allowlist": [
            {
                "path": "__init__.py",
                "names": ["comfy_entrypoint", "Extension.on_load", "Extension.get_node_list"],
                "reason": "ComfyUI calls these extension hooks itself."
            },
            {
                "path": "src/dreamina/contract.py",
                "names": ["validate_cli"],
                "reason": "Called by a node built in a later milestone."
            },
            {
                "path": "src/dreamina/models.py",
                "names": ["find_model"],
                "reason": "The generation nodes and Model: Info find models here; 08 Part B removes this entry with GenerationOperation."
            },
            {
                "path": "src/dreamina/modes.py",
                "names": ["choose_mode"],
                "reason": "The generation run chooses its mode here; 08 Part B removes this entry with GenerationOperation."
            },
            {
                "path": "src/dreamina/arguments.py",
                "names": ["build_flags", "choose_prompt", "parse_arguments", "validate_argument_names"],
                "reason": "The generation run and its queue check read arguments here; 08 Part B removes this entry with GenerateNode."
            }
        ]
    },
    "shell": {
        "max_trivial_statements": 2
    }
}
