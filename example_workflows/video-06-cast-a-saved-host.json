      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "1. Sign in to Dreamina in **ComfyUI menu → Extensions → Dreamina → Dreamina Settings**.\n2. Upload three pictures from `example_workflows/assets/` in this pack's folder: `dreamina/host.webp` in **Host**, `dreamina/host-full-body.webp` in **Full Body**, and `live-shopping/kitchen-counter.webp` in **Place**.\n3. In **Scene**, say what happens. `{{reference1}}` stands for the host and `{{image1}}` for the place.\n4. Press **Run**. The video is saved under `video/dreamina`."
      ],
      "title": "Start Here"
    },
