      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "Seedream 5.0 Lite draws the host in a `9:16` frame. This picture becomes the video's first frame. `references`, what an earlier Dreamina step made, passes it on to **Animate** with no download or upload."
      ],
      "title": "Note"
    },
    {
      "id": 3,
      "type": "MarkdownNote",
      "pos": [
        860,
        60
