      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "**Model: Info** shows what a Dreamina model takes: its modes, its settings with their choices and limits, and a speech model's voices. It is free. **Info** shows Seed Audio, the audio node's starting model, with its 13 voices.\n\nTo change the voice, copy a name from **Info**, open **Voice**, and put it in `arguments` as `voice-name`."
      ],
      "title": "Note"
    },
    {
      "id": 3,
      "type": "MarkdownNote",
      "pos": [
