          "widget": {
            "name": "text"
          }
        }
      ],
      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "**Element: Add** saves the portrait as an Element named **Host**, a character Dreamina keeps so it looks the same in every video. Making an Element is free. Its `references` output gives both shots the same host.\n\nTo keep more angles of the host, connect them to `auxiliary`. A voice clip goes in `voice`."
      ],
      "title": "Note"
    },
    {
      "id": 4,
      "type": "MarkdownNote",
      "pos": [
        1290,
        60
      ],
      "size": [
        400,
        108
