          "widget": {
            "name": "text"
          }
        }
      ],
      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "Seedream 5.0 Lite draws the host from the waist up. `references`, what an earlier Dreamina step made, passes the portrait on to **Keep**."
      ],
      "title": "Note"
    },
    {
      "id": 3,
      "type": "MarkdownNote",
      "pos": [
        860,
        60
      ],
      "size": [
        400,
        108
      ],
      "flags": {},
