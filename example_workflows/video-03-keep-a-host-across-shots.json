      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "1. Sign in to Dreamina in **ComfyUI menu → Extensions → Dreamina → Dreamina Settings**.\n2. Describe the host in **Host**.\n3. Say what happens in the first shot in **Opening**, and in the second in **Closing**.\n4. Press **Run**. Both shots are saved under `video/dreamina`."
      ],
      "title": "Start Here"
    },
    {
      "id": 2,
      "type": "MarkdownNote",
      "pos": [
        430,
        60
      ],
      "size": [
        400,
        108
      ],
