      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "Seedream 5.0 Lite draws the poster at `2K`, its smallest size, in a `3:4` frame. `references`, what an earlier Dreamina step made, passes the poster on to **Enlarge** with no download or upload."
      ],
      "title": "Note"
    },
